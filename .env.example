# Exemplo de variaveis de ambiente para execucao local do Backend
# Copie este arquivo para .env e preencha com seus valores reais

SECRET_KEY=gere-uma-chave-aleatoria-segura
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua-senha-postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=iot_farm_db

MONGO_URI=mongodb://usuario:senha@localhost:27017
MONGO_DB_NAME=iot_telemetry_db

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_USER=seu-usuario-mqtt
MQTT_BROKER_PASSWORD=sua-senha-mqtt

# Opcional: codigo de convite para cadastro de novos usuarios
REGISTRATION_INVITE_CODE=
